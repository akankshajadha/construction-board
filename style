body {
  background-color: #f0f0f0;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  margin: 0;
  font-family: 'Share Tech Mono', monospace;
}

/* Outer Signboard Box */
.signboard-container {
  background-color: #0b0b0b;
  padding: 15px;
  border: 12px solid #ffffff;
  border-radius: 8px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  width: 100%;
  max-width: 650px;
  box-sizing: border-box;
}

/* Screen Matrix Backing */
.led-screen {
  border: 3px solid #e65c00;
  padding: 5px;
  background: radial-gradient(circle, #151525 0%, #05050a 100%);
}

/* Grid Layout structure */
.board-table {
  width: 100%;
  border-collapse: collapse;
  text-transform: uppercase;
  text-align: center;
}

/* Header Text Glows */
.main-header {
  color: #00e5ff;
  font-size: 1.8rem;
  letter-spacing: 2px;
  padding: 12px 0;
  text-shadow: 0 0 8px rgba(0, 229, 255, 0.8);
  border-bottom: 3px double #00e5ff;
}

/* Column Header Subdivisions */
.column-headers th {
  color: #ffffff;
  font-size: 1.1rem;
  padding: 10px 5px;
  letter-spacing: 1px;
  border-bottom: 2px solid #ffffff;
  border-right: 2px dashed rgba(255, 255, 255, 0.3);
}

.column-headers th:last-child {
  border-right: none;
}

.col-param { width: 30%; }
.col-conc  { width: 25%; }
.col-unit  { width: 25%; }
.col-std   { width: 20%; }

/* Grid Separation Rules */
.board-table td {
  padding: 12px 5px;
  font-size: 1.3rem;
  border-bottom: 2px dashed rgba(255, 255, 255, 0.15);
  border-right: 2px dashed rgba(255, 255, 255, 0.3);
}

.board-table tr:last-child td {
  border-bottom: none;
}

.board-table td:last-child {
  border-right: none;
}

/* LED Matrix Color Assignments */
.param-cell {
  color: #ff6600;
  text-shadow: 0 0 6px rgba(255, 102, 0, 0.8);
  font-weight: bold;
}

.conc-cell {
  color: #00ff66;
  text-shadow: 0 0 8px rgba(0, 255, 102, 0.9);
  font-size: 1.5rem;
  font-weight: bold;
  transition: all 0.3s ease;
}

.unit-cell {
  color: #ff3333;
  text-shadow: 0 0 6px rgba(255, 51, 51, 0.8);
  font-family: 'Courier Prime', monospace;
  font-size: 1.1rem;
}

.std-cell {
  color: #00ff66;
  text-shadow: 0 0 8px rgba(0, 255, 102, 0.8);
  font-weight: bold;
}

/* Live updating pulse flash effect */
.flash-update {
  animation: pulse 0.5s ease-in-out;
}

@keyframes pulse {
  0% { opacity: 0.3; transform: scale(0.95); }
  50% { opacity: 1; transform: scale(1.05); color: #ffffff; text-shadow: 0 0 15px #ffffff; }
  100% { opacity: 1; transform: scale(1); }
}








<script> const BACKEND_URL = "http://localhost:8080/api/v1/environment/live";

// OPTION B: Free Live Cloud API (Uncomment if you want real data without running a terminal)
// const BACKEND_URL = "https://open-meteo.com";

function updateRowTimestamps() {
    const now = new Date();
    const dateString = now.toLocaleDateString('en-GB'); // DD/MM/YYYY
    const timeString = now.toLocaleTimeString('en-GB'); // HH:MM:SS
    const combinedDateTime = `${dateString}  ${timeString}`;

    document.querySelectorAll('.datetime-cell').forEach(cell => cell.innerText = combinedDateTime);
}

async function fetchLiveBackendData() {
    try {
        const response = await fetch(BACKEND_URL);
        if (!response.ok) throw new Error("Connection lost");
        const data = await response.json();

        // 1. Parse data depending on source structure
        // Handles both your local server layout and the cloud weather layout safely
        const temp = data.temperature !== undefined ? data.temperature : (data.current ? Math.round(data.current.temperature_2m) : "--");
        const hum = data.humidity !== undefined ? data.humidity : (data.current ? Math.round(data.current.relative_humidity_2m) : "--");
        const pm25 = data.pm25 !== undefined ? data.pm25 : 28; // Fallback mock values for cloud weather
        const pm10 = data.pm10 !== undefined ? data.pm10 : 64;

        // 2. Inject raw live text data into your exact table grid IDs
        if(document.getElementById("tempDisplay")) document.getElementById("tempDisplay").innerText = temp;
        if(document.getElementById("humDisplay")) document.getElementById("humDisplay").innerText = hum;
        if(document.getElementById("pm25Display")) document.getElementById("pm25Display").innerText = pm25;
        if(document.getElementById("pm10Display")) document.getElementById("pm10Display").innerText = pm10;

        // 3. Update the single-line timestamp text element
        updateRowTimestamps();

        // Show successful data connection sync visual states
        const statusIndicator = document.getElementById("liveIndicator");
        if (statusIndicator) {
            statusIndicator.innerText = "● LIVE UPDATE ACTIVE";
            statusIndicator.style.color = "#00e400"; // Solid green
        }

    } catch (error) {
        console.error("Live fetch step error:", error);
        const statusIndicator = document.getElementById("liveIndicator");
        if (statusIndicator) {
            statusIndicator.innerText = "● BACKEND STREAM OFFLINE";
            statusIndicator.style.color = "#ff0000"; // Solid red
        }
    }
}

// Fire data request immediately on launch
fetchLiveBackendData();

// Continuously stream live updates automatically every 10 seconds (10000ms)
setInterval(fetchLiveBackendData, 10000);
   </script>